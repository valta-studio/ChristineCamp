---
import { getT, type Locale, type PriceRow } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);
const rows = t('prices.rows', { returnObjects: true }) as PriceRow[];
---

<section class="section" id="prices">
  <div class="container">
    <span class="section__kicker">{t('prices.kicker')}</span>
    <h2 class="section__title">{t('prices.title')}</h2>
    <p class="section__lead">{t('prices.lead')}</p>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">{t('prices.colItem')}</th>
            <th scope="col">
              {t('prices.colOff')}
              <span class="th-sub">{t('prices.colOffSub')}</span>
            </th>
            <th scope="col">
              {t('prices.colPeak')}
              <span class="th-sub">{t('prices.colPeakSub')}</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <th scope="row">
                  {row.label}
                  {row.note && <span class="row-note">{row.note}</span>}
                </th>
                <td>
                  <span class="mobile-season" aria-hidden="true">
                    <strong>{t('prices.colOff')}</strong>
                    <small>{t('prices.colOffSub')}</small>
                  </span>
                  <span class="price-value">{row.off}</span>
                </td>
                <td>
                  <span class="mobile-season" aria-hidden="true">
                    <strong>{t('prices.colPeak')}</strong>
                    <small>{t('prices.colPeakSub')}</small>
                  </span>
                  <span class="price-value">{row.peak}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="footnote">{t('prices.footnote')}</p>
  </div>
</section>

<style>
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-top: 1.5rem;
  }

  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 0.98rem;
  }

  thead th {
    background: var(--blue-deep);
    color: #fff;
    text-align: left;
    padding: 0.9rem 1.1rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  thead th + th {
    text-align: right;
    width: 175px;
  }

  .th-sub {
    display: block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: rgba(255, 255, 255, 0.78);
  }

  tbody th {
    text-align: left;
    font-weight: 600;
    color: var(--ink);
    padding: 0.75rem 1.1rem;
  }

  tbody td {
    text-align: right;
    padding: 0.75rem 1.1rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--blue-dark);
    white-space: nowrap;
  }

  .mobile-season {
    display: none;
  }

  tbody tr:nth-child(even) {
    background: var(--mist);
  }

  tbody tr + tr {
    border-top: 1px solid var(--line);
  }

  .row-note {
    display: block;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--muted);
  }

  .footnote {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    table {
      min-width: 0;
      font-size: 0.8rem;
    }

    thead th {
      padding: 0.55rem 0.5rem;
      font-size: 0.82rem;
      letter-spacing: 0.02em;
    }

    thead th + th {
      width: auto;
    }

    .th-sub {
      font-size: 0.6rem;
    }

    tbody th {
      padding: 0.5rem 0.5rem;
      font-size: 0.82rem;
      line-height: 1.3;
    }

    tbody td {
      padding: 0.5rem 0.5rem;
      font-size: 0.82rem;
    }

    .price-value {
      font-weight: 700;
    }

    tbody td:last-child .price-value {
      color: var(--accent);
    }

    .row-note {
      font-size: 0.72rem;
      line-height: 1.3;
    }
  }

  @media (max-width: 380px) {
    thead th,
    tbody th,
    tbody td {
      padding: 0.45rem 0.35rem;
    }

    table {
      font-size: 0.75rem;
    }
  }
</style>
