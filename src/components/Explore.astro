---
import { getT, type Locale, type Sight } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);
const items = t('explore.items', { returnObjects: true }) as Sight[];
const activities = t('explore.activities', { returnObjects: true }) as string[];
---

<section class="section section--tint" id="explore">
  <div class="container">
    <span class="section__kicker">{t('explore.kicker')}</span>
    <h2 class="section__title">{t('explore.title')}</h2>
    <p class="section__lead">{t('explore.lead')}</p>

    <ul class="grid">
      {
        items.map((item) => (
          <li class="card">
            <div class="card__head">
              <h3 class="card__title">{item.title}</h3>
              <span class="card__distance">{item.distance}</span>
            </div>
            <p class="card__text">{item.text}</p>
          </li>
        ))
      }
    </ul>

    <h3 class="activities__title">{t('explore.activitiesTitle')}</h3>
    <ul class="activities">
      {activities.map((activity) => <li class="activities__chip">{activity}</li>)}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem 1.5rem 1.4rem;
    box-shadow: 0 4px 14px rgba(13, 72, 100, 0.05);
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .card__title {
    font-size: 1.15rem;
    margin: 0;
  }

  .card__distance {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--blue-dark);
    background: var(--mist);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    white-space: nowrap;
  }

  .card__text {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }

  .activities__title {
    font-size: 1.2rem;
    margin: 2.5rem 0 1rem;
  }

  .activities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .activities__chip {
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--blue), var(--turquoise));
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
