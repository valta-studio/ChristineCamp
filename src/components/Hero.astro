---
import { Picture } from 'astro:assets';
import lake from '../assets/lake.jpg';
import logoMark from '../assets/logo.svg';
import { getT, SITE, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);
---

<section class="hero">
  <Picture
    class="hero__image"
    src={lake}
    widths={[640, 1024, 1600, 2048]}
    sizes="100vw"
    formats={['avif', 'webp']}
    alt={t('hero.tagline')}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__overlay"></div>
  <div class="container hero__content">
    <img class="hero__logo" src={logoMark.src} alt="" width="138" height="63" loading="eager" />
    <p class="hero__camping">Camping</p>
    <h1 class="hero__title">
      {SITE.name.replace('Camping ', '')}
      <span class="hero__sub">{SITE.subtitle}</span>
    </h1>
    <p class="hero__tagline">{t('hero.tagline')}</p>
    <p class="hero__intro">{t('hero.intro')}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="#prices">{t('hero.ctaPrices')}</a>
      <a class="btn btn--ghost" href="#contact">{t('hero.ctaContact')}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(88vh, 780px);
    overflow: hidden;
  }

  .hero :global(.hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(9, 42, 60, 0.72) 0%,
      rgba(9, 42, 60, 0.25) 45%,
      rgba(9, 42, 60, 0.12) 100%
    );
  }

  .hero__content {
    position: relative;
    color: #fff;
    padding: 5rem 0;
    max-width: 1080px;
  }

  .hero :global(.hero__logo) {
    display: block;
    margin-bottom: 0.9rem;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
  }

  .hero__camping {
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    color: #ffb59e;
    margin: 0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .hero__title {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #fff;
    margin: 0 0 0.4rem;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .hero__sub {
    display: block;
    font-size: clamp(0.85rem, 1.8vw, 1.1rem);
    font-weight: 500;
    letter-spacing: 0.45em;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    font-weight: 600;
    margin: 1.2rem 0 0.4rem;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
  }

  .hero__intro {
    max-width: 34rem;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.92);
    margin: 0 0 1.8rem;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
</style>
