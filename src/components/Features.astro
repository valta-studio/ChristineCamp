---
import { getT, type Feature, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);
const items = t('features.items', { returnObjects: true }) as Feature[];

const icons: Record<string, string> = {
  wave: 'M2 17c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 12c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2',
  mountain: 'M3 20 10 7l4 7 3-4 4 10Zm7-13 2.5 4.5',
  tent: 'M12 4 3 20h18L12 4Zm0 8-4 8m4-8 4 8',
  plug: 'M9 3v5m6-5v5M7 8h10v3a5 5 0 0 1-10 0V8Zm5 8v5',
  dog: 'M5 20v-6l3-6h6l2 3h4l-1 3h-3l-1 6m-8 0h2m4 0h2M8 8V5l3 3',
  sun: 'M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-15v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4',
};
---

<section class="section section--tint" id="features">
  <div class="container">
    <span class="section__kicker">{t('features.kicker')}</span>
    <h2 class="section__title">{t('features.title')}</h2>
    <ul class="grid">
      {
        items.map((item) => (
          <li class="card">
            <span class="card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[item.icon]} />
              </svg>
            </span>
            <h3 class="card__title">{item.title}</h3>
            <p class="card__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem 1.5rem;
    box-shadow: 0 4px 14px rgba(13, 72, 100, 0.05);
  }

  .card__icon {
    display: inline-flex;
    width: 46px;
    height: 46px;
    padding: 10px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--blue), var(--turquoise));
    color: #fff;
    margin-bottom: 0.9rem;
  }

  .card__icon svg {
    width: 100%;
    height: 100%;
  }

  .card__title {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }

  .card__text {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
  }
</style>
