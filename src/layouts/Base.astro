---
import { getImage } from 'astro:assets';
import lake from '../assets/lake.jpg';
import { getT, getLocaleMeta, LOCALES, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);
const localeMeta = getLocaleMeta(locale);

const ogImage = await getImage({ src: lake, width: 1200, height: 630, format: 'jpeg' });

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(localeMeta.path, site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l.code} href={new URL(l.path, site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, site)} />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
  </body>
</html>
