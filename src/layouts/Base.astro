---
import { getImage } from 'astro:assets';
import lake from '../assets/lake.jpg';
import { getDict, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);

const ogImage = await getImage({ src: lake, width: 1200, height: 630, format: 'jpeg' });

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(locale === 'de' ? '/' : '/en/', site);
const alternateDe = new URL('/', site);
const alternateEn = new URL('/en/', site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{dict.meta.title}</title>
    <meta name="description" content={dict.meta.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={alternateDe} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateDe} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={dict.meta.title} />
    <meta property="og:description" content={dict.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, site)} />
    <meta property="og:locale" content={locale === 'de' ? 'de_AT' : 'en_GB'} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
  </body>
</html>
